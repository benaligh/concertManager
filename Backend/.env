# In all environments, the following files are loaded if they exist,
# the later taking precedence over the former:
#
#  * .env                contains default values for the environment variables
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/best_practices.html#use-secrets-in-production
#
# Run "composer dump-env prod" to compile .env files for production use.
# https://symfony.com/doc/current/best_practices.html#dump-env-compile

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=your-secret-key-change-in-production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format: "mysql://user:password@127.0.0.1:3306/database_name?serverVersion=8.0&charset=utf8mb4"
# 
# Exemple MySQL (modifiez selon votre configuration) :
DATABASE_URL="mysql://root:root@127.0.0.1:3306/concert_manager?serverVersion=8.0&charset=utf8mb4"

# Alternative PostgreSQL :
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/concert_manager?serverVersion=13&charset=utf8"

# Alternative SQLite (développement) :
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
